    <string name="retire_finish_title">¿Retirada / Llegada?</string>
    <string name="retire_finish_message">Úsalo solo si te retiras de la regata o has finalizado.\n\nEsto detiene el seguimiento de regata para este barco. Si te retiras, puedes quedar fuera de la clasificación.</string>
    <string name="is_this_your_boat">¿Este es tu barco?</string>
    <string name="confirm_boat_message">Confirma los datos del barco antes de entrar en regata.\n\nNombre del barco: %1$s\nPatrón: %2$s\nNúmero de vela: %3$s\nTipo de barco: %4$s\nColor del casco: %5$s\nYardstick: %6$s\n\nEstos valores se utilizarán para el seguimiento de regata y se enviarán al servidor de regata.</string>
    <string name="clear_race_title">¿Borrar regata?</string>
    <string name="clear_race_message">Esto elimina la regata escaneada de este dispositivo.\n\nLa configuración del barco no cambiará.\n\nTendrás que volver a escanear el código QR antes de registrarte o entrar en regata.</string>
